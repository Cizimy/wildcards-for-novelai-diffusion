{
  "manifest_version": 3,
  "name": "Wildcards for NovelAI Diffusion",
  "description": "Enhanced wildcards with weighted selection, conditional logic, and hierarchical support for NovelAI Diffusion",
  "version": "3.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://image.novelai.net/*"],
  "content_scripts": [
    {
      "matches": ["*://*.novelai.net/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injector.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": { "default_popup": "popup.html" }
}
